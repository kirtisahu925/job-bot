{
  "manifest_version": 3,
  "name": "Job Tracker Autofill",
  "version": "0.1.0",
  "description": "Autofills job applications, attaches your tailored resume, and saves jobs to your tracker. Never submits.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Job Tracker" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.naukri.com/*",
        "https://*.foundit.in/*",
        "https://wellfound.com/*"
      ],
      "js": ["lib/urlkey.js", "lib/extract.js", "content/capture.js"],
      "run_at": "document_idle"
    }
  ]
}
