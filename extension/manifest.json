{
  "manifest_version": 3,
  "name": "Fairsheet Autofill",
  "version": "0.5.0",
  "description": "Autofills job applications, attaches your tailored resume, queues your ready jobs, and saves jobs (or a whole Naukri search page) to your tracker. Never submits: you do.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fairsheet"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.naukri.com/*",
        "https://*.foundit.in/*",
        "https://wellfound.com/*"
      ],
      "js": [
        "lib/urlkey.js",
        "lib/extract.js",
        "lib/listing.js",
        "content/capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
