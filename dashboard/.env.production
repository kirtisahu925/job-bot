# Used by `npm run build` (Cloudflare Pages builds this way), so the host needs no environment variables.
# These are public values: the anon key ships in every browser bundle by design, and row-level security
# lets only the owner's login read or change data. Running your own copy? Put your project's URL and anon
# key here (Supabase > Project Settings > API keys), or override them with Cloudflare environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
