# Supabase project URL and anon (public) key. The anon key is safe in the browser: RLS only lets
# your own login read or change data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to 1 to browse the UI with built-in sample data and no Supabase at all.
VITE_DEMO=0
